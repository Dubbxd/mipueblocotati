# ─── API (server/) ───────────────────────────────────────────────
# Postgres en Railway. NO commitear el real.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Auth
JWT_SECRET=cambia-esto-por-un-string-aleatorio-largo
JWT_EXPIRES_IN=7d

# Bootstrap admin (se crea en seed si no existe)
ADMIN_EMAIL=admin@mipueblocotati.com
ADMIN_PASSWORD=cambia-esto-en-prod

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Uploads (Railway volume mount path o ./uploads en dev)
UPLOAD_DIR=./uploads
PUBLIC_UPLOADS_URL=http://localhost:3001/uploads

# ─── Web (app/) ──────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001
