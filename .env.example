# ────────────────────────────────────────────────────────────────────────────
# Mi Pueblo Cotati — Environment Variables
# Copy to .env and fill in your values.  NEVER commit .env (listed in .gitignore).
# In Dokploy: configure each variable in the service's Environment panel.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_64_char_hex_string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@mipueblocotati.com
ADMIN_PASSWORD=ChangeMe2026!

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Allowed CORS origins — comma-separated (production frontend URL)
CORS_ORIGIN=https://www.mipueblocotati.com

# ── URLs ─────────────────────────────────────────────────────────────────────
# Production frontend URL (no trailing slash)
PUBLIC_URL=https://www.mipueblocotati.com
# Production API URL used for unsubscribe links, etc.
API_URL=https://www.mipueblocotati.com
# nginx host port (docker-compose)
WEB_PORT=80

# ── Mailjet ──────────────────────────────────────────────────────────────────
MAILJET_API_KEY=your_mailjet_api_key
MAILJET_SECRET_KEY=your_mailjet_secret_key
MAILJET_FROM_EMAIL=noreply@yourdomain.com
MAILJET_FROM_NAME=Mi Pueblo Cotati
MAILJET_ADMIN_EMAIL=admin@mipueblocotati.com

# ── OpenAI (optional — blog / newsletter AI generation) ──────────────────────
OPENAI_API_KEY=sk-...

# ── Storage ──────────────────────────────────────────────────────────────────
# "local" = Docker volume  |  "s3" = S3-compatible object storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
PUBLIC_UPLOADS_URL=https://www.mipueblocotati.com/uploads

# ── S3-compatible (only when STORAGE_DRIVER=s3) ──────────────────────────────
S3_ENDPOINT=https://your-s3-endpoint
S3_REGION=us-east-1
S3_BUCKET=mipueblo-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL=
S3_USE_PRESIGNED=false
S3_PRESIGN_EXPIRES=604800

# ── Web (app/) — only needed for standalone non-proxied deploys ───────────────
# Leave empty when using the docker-compose nginx proxy (default).
VITE_API_URL=
